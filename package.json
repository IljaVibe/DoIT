{
  "name": "doit-desktop",
  "productName": "DoIT",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Спокойное пространство для задач, мыслей и планов",
  "author": "DoIT",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/setup-electron.cjs",
    "format": "prettier --write src electron scripts tests vite.config.ts",
    "dev": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "build": "tsc --noEmit && vite build",
    "test": "node tests/store.test.cjs",
    "test:ui": "node scripts/smoke.cjs",
    "test:desktop": "node scripts/desktop-smoke.cjs",
    "dist:win": "npm run build && electron-builder --win zip --x64",
    "dist:linux": "npm run build && electron-builder --linux dir --x64"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sql.js": "^1.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "playwright-core": "^1.56.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "app.doit.desktop",
    "productName": "DoIT",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "extraFiles": [
      {
        "from": "resources/ПРОЧИТАЙТЕ.txt",
        "to": "ПРОЧИТАЙТЕ.txt"
      }
    ],
    "win": {
      "target": "zip",
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "dir",
      "category": "Office"
    },
    "artifactName": "DoIT-${version}-Windows-${arch}.${ext}"
  }
}
